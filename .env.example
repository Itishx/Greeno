# Greeno / Braino Companion
# Copy to .env and fill in. Never commit .env.

# Text, vision, transcription, and the TTS fallback.
OPENAI_API_KEY=

# The voice. Without this he falls back to OpenAI TTS and sounds generic.
FISH_AUDIO_API_KEY=
# Braino's own voice. Brainelle is b67aedfb36d04c53892fd0e96db08180
FISH_AUDIO_REFERENCE_ID=88b183bfbdda44a09ad4474712b967f4
# Speed, not identity. s2.1-pro is about 70ms to first audio, s2-pro about 100ms.
FISH_AUDIO_MODEL=s2.1-pro

# Optional. Falls back to the values in app/lib/models.cjs when unset.
BRAINO_TEXT_MODEL=gpt-5.6-luna
TRANSCRIBE_MODEL=gpt-4o-transcribe
DICTATION_REFINEMENT_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
ENABLE_OPENAI_TTS_FALLBACK=true

# Morning greet, layer 2. Leave blank to run on the notebook alone.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8788/oauth/callback
